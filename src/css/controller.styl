#board .controller
    border: solid 4px transparent
    border-radius: 6px
    line-height: 1
    padding: 6px
    img
        width: 20px
        height: 20px
        margin: 2px 4px
        opacity: 0.2
    .speed
        line-height: 1
        img
            width: 16px
            height: 16px
        .step
            display: inline-block
            background: white
            width: 16px
            height: 8px
            border-radius: 4px
            margin: 6px 1px
            opacity: 0.1
    &:hover
        border-color: #333
        background: black
        img
            opacity: 0.5
            &:hover
                opacity: 1
        .step
            opacity: 0.2

@media screen and (max-width: 820px)
    #board .controller
        padding: 4px
        border: none
        text-align: center
        > div
        .speed
            display: inline
        img
            margin: 2px 12px
            opacity: 0.5
        .step
            opacity: 0.2

@media screen and (max-height: 450px)
    #board .controller
        width: 40px
        height: auto
        margin-top 8px
        padding: 0
        border: none
        img
            display: block
            width: 24px
            height: 24px
            margin: 8px auto
            opacity: 0.2
        .speed
            img
                width: 24px
                height: 24px
                margin: 2px auto
            .step
                display: block
                width: 24px
                margin: 2px auto
                opacity: 0.1
