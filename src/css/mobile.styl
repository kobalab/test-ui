#board .board .score
    height: 100px
    transform: translate(240px, 165px)
    div:has(> .jushu)
        height: 58px
    .jushu
        float: left
        font-size: 28px
    div:has(> .chouma)
        float: left
        padding-left: 2px
        padding-right: 0
    img.chouma
        width: 28px
        height: 6px
    .shan
        padding: 2px
        height: 58px
        .pai
            pai-size: 34px
    .defen
        div
            width: 90px
            height: 20px
            &.main
                transform: translate(95px, 15px)
            &.xiajia
                transform: translate(185px, 0px)
            &.duimian
                transform: translate(95px, -15px)
            &.shangjia
                transform: translate(5px, 0px)

#board .board
    > .player
        font-size: 16px
        width: 120px
        height: 24px
        border-radius: 4px
        &.main
            transform: translate(164px, 352px)
        &.xiajia
            transform: translate(499px, 295px)
        &.duimian
            transform: translate(460px, 50px)
        &.shangjia
            transform: translate(125px, 107px)
    .shoupai
        &.main
            z-index: 1
            shoupai-size: 604px 60px 52px 40px
            transform: translate(78px, 388px)
        &.xiajia
            shoupai-size: 448px 87px 34px 34px
            transform: translate(652px, 450px) rotate(270deg)
            .bingpai
                margin-left: 72px
        &.duimian
            shoupai-size: 490px 48px 34px 34px
            transform: translate(625px, 52px) rotate(180deg)
        &.shangjia
            shoupai-size: 448px 87px 34px 34px
            transform: translate(108px, 0px) rotate(90deg)
            .bingpai
                margin-left: 20px
    .he
        he-size: 250px 34px
        &.main
            transform: translate(305px, 265px)
        &.xiajia
            transform: translate(520px, 290px) rotate(270deg)
        &.duimian
            transform: translate(455px, 165px) rotate(180deg)
        &.shangjia
            transform: translate(240px, 140px) rotate(90deg)
    .say
        z-index: 1
        width:  200px
        height: 100px
        font-size: 64px
        &.main
            transform: translate(280px, 295px)
        &.xiajia
            transform: translate(520px, 165px)
        &.duimian
            transform: translate(280px, 35px)
        &.shangjia
            transform: translate(40px, 165px)

#board .board .dialog
    z-index: 1
    height: 450px
    > div
        width: 760px
        min-height: 340px
        padding: 10px 0
        > div
            min-width: 420px
            padding: 10px
    .shan .pai
        pai-size: 32px
    .shoupai
        shoupai-size: auto 66px 44px 44px
    .hupai
        min-width: 240px
        font-size: 20px
    :has(> .changbang):has(> .lizhibang)
        font-size: 14px
    .pingju
        font-size: 40px
        margin-top: 40px
        margin-bottom: 60px

#board .board .summary
    z-index: 1
    height: 450px
    > div
        min-height: 360px
        > div
            padding: 12px 0px
            table
                font-size: 16px
            .r_point .point
                font-size: 20px

#board .board .kaiju
    z-index: 1
    height: 450px
    > div
        margin: 40px auto auto

#board .board .select-action
    transform: translate(78px, 348px)
    .button
        5em
        padding: 8px 0
