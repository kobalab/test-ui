#navi .navi
    font-size: 12px
    font-family: menu-font
    img[role="button"]
    .version
        display: none
    ul
        margin: 0
        padding: 0
        text-align: right
        a
            color: inherit
            text-decoration: none
        li
            display: inline-block
        li + li:before
            content: ' | '

#board .navi
    position: absolute
    top: 0
    z-index: 2
    font-size: 20px
    font-family: text-font
    color: white
    img[role="button"]
        width: 24px
        height: 24px
        margin: 10px
        opacity: 0.3
    ul
        display: none
        margin: 0
        padding: 0
        width: 360px
        a
            color: inherit
            text-decoration: none
        li
            list-style-type: none
            padding: 2px 1em
    .version
        display: none
        font-family: defen-font
        padding 0.5em
        text-align: right
    &.active
        background: black
        img[role="button"]
            opacity: 1
        ul
        .version
            display: block
