#navi .navi
    font-size: 12px
    font-family: menu-font
    img[role="button"]
    .version
        display: none
    ul
        margin: 0
        padding: 0
        text-align: right
        a
            color: inherit
            text-decoration: none
        li
            display: inline-block
        li + li:before
            content: ' | '

@media screen and (max-width: 800px)
    body.title
    body.board
        #navi .navi > div
            margin: 0 1em

#board .navi
    position: absolute
    top: 0
    z-index: 2
    font-size: 18px
    font-family: text-font
    color: white
    img[role="button"]
        width: 24px
        height: 24px
        margin: 10px
        opacity: 0.3
    ul
        display: none
        margin: 0
        padding: 0
        width: 240px
        a
            display: block
            color: inherit
            text-decoration: none
            padding: 2px 1em
            &:active
                background: #666
        li
            list-style-type: none
    .version
        display: none
        font-family: defen-font
        padding 0.5em
        text-align: right
    &.active
        width: 100%
        height: 100%
        background: rgba(0,0,0,0.3)
        > div
            display: table
            background: black
            img[role="button"]
                opacity: 1
            ul
            .version
                display: block
