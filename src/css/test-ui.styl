body.font
    dl
        margin-left: 40px
        font-size: 18px
    dt
        font-family: fixed-font
    .title
        font-family: title-font
        font-size: 28px
    .text
        font-family: text-font
        font-size: 24px
    .menu
        font-family: menu-font
    .defen
        font-family: defen-font
    .fixed
        font-family: fixed-font

body.pai
    .pai
        pai-size: 44px;

body.mianzi
    .shoupai
        float: left
        margin: 10px;
        shoupai-size: auto 72px 48px 48px

body.shoupai
    .shoupai
        margin-top: 1em
        background: #036
        padding: 4px
    .shoupai:nth-child(1)
        shoupai-size: auto 52px 36px 36px
        min-width: 382px
    .shoupai:nth-child(2)
        shoupai-size: 420px 42px 36px 28px
    .shoupai:nth-child(3)
        shoupai-size: 382px 80px 36px 28px

body.shan
    .shan
        font-size: 12px
        .pai
            pai-size: 36px
        .baopai
        .fubaopai
            display: inline-block
            margin-right: 1em
    .zimo
        line-height: 0
        .pai
            pai-size: 32px

body.he
    .he
        background: #036
        padding: 4px
        margin-bottom: 1em
    .he:nth-child(1)
        he-size: 610px 36px line
    .he:nth-child(2)
        he-size: 270px 36px block
    .he:nth-child(3)
        he-size: 270px 36px block

body.title
    #demo
        display: none

#demo
    #loaddata
        display: block
        .pai
            pai-size: 56px
    > img
        width: 600px

#debug
    z-index: 1
    bottom: 0
    right: 0
    font-size: 16px
    font-family: fixed-font
    margin: 4px
    padding: 8px
    background: black
    border-radius: 8px
    opacity: 0.8
