#board .board
    box-sizing: border-box;
    background: #154
    > *
        position: absolute
        transform-origin: 0% 0%

#board .board .score
    box-sizing: border-box;
    background: #111
    font-family: defen-font
    div:has(> .jushu)
        float: left
    .jushu
        line-height: 1
        font-family: title-font
    .jushu + div
        display: table
        margin: auto
    .shan
        float: right
        text-align: right
    .defen
        clear: both
        div
            position: absolute
            &.lunban
                color: #0ff
            &.main
                text-align: center
            &.xiajia
                text-align: right
            &.duimian
                text-align: center
            &.shangjia
                text-align: left

#board .board
    .shoupai
        box-sizing: border-box;
        // border: solid 1px white
    .he
        box-sizing: border-box;
        // border: solid 1px blue
