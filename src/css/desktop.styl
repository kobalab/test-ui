#board .board .score
    width: 280px
    height: 160px
    transform: translate(260px, 260px)
    border-radius: 4px
    font-size: 14px
    div:has(> .jushu)
        height: 72px
    .jushu
        padding: 4px
        font-size: 32px
    img.chouma
        width: 60px
        height: 8px
    .shan
        height: 72px
        padding: 4px
        .pai
            pai-size: 40px
    .defen
        div
            width: 120px
            height: 24px
            font-size: 16px
            &.main
                transform: translate(80px, 48px)
            &.xiajia
                transform: translate(150px, 24px)
            &.duimian
                transform: translate(80px, 0px)
            &.shangjia
                transform: translate(10px, 24px)

#board .board
    > .player
        font-size: 20px
        width: 160px
        height: 30px
        border-radius: 6px
        padding: 2px 0.5em
        &.main
            transform: translate(120px, 580px)
        &.xiajia
            transform: translate(540px, 440px)
        &.duimian
            transform: translate(500px, 60px)
        &.shangjia
            transform: translate(80px, 206px)
    .shoupai
        &.main
            shoupai-size: 680px 60px 56px 40px
            transform: translate(120px, 620px)
        &.xiajia
            shoupai-size: 560px 60px 40px 40px
            transform: translate(740px, 560px) rotate(270deg)
        &.duimian
            shoupai-size: 680px 60px 40px 40px
            transform: translate(680px, 60px) rotate(180deg)
        &.shangjia
            shoupai-size: 560px 60px 40px 40px
            transform: translate(60px, 120px) rotate(90deg)
    .he
        he-size: 300px 40px
        &.main
            transform: translate(310px, 420px)
        &.xiajia
            transform: translate(540px, 430px) rotate(270deg)
        &.duimian
            transform: translate(490px, 260px) rotate(180deg)
        &.shangjia
            transform: translate(260px, 250px) rotate(90deg)
    .say
        width:  200px
        height: 100px
        font-size: 64px
        &.main
            transform: translate(300px, 520px)
        &.xiajia
            transform: translate(600px, 290px)
        &.duimian
            transform: translate(300px, 50px)
        &.shangjia
            transform: translate(0px, 290px)

#board .board .dialog
    width: 800px
    height: 680px
    > div
        width: 800px
        min-height: 460px
        padding: 10px 0
        > div
            min-width: 460px
            padding: 20px
    .shan .pai
        pai-size: 36px
    .shoupai
        shoupai-size: auto 76px 48px 48px
    .hupai
        margin: 10px auto
        min-width: 280px
        font-size: 24px
    :has(> .changbang):has(> .lizhibang)
        font-size: 16px
        img
            padding-left: 8px
            width: 60px
            height: 8px
    .pingju
        font-size: 48px
        margin-top: 50px
        margin-bottom: 100px
    .fenpei
        width: 380px
        height: 80px
        margin: 15px auto
        font-size: 16px
        > *
            width: 88px
            &.main
                transform: translate(146px, 48px)
            &.xiajia
                transform: translate(292px, 24px)
            &.duimian
                transform: translate(146px, 0px)
            &.shangjia
                transform: translate(0px, 24px)
            .defen
                width: 60px

#board .board .summary
    width: 800px
    height: 680px
    > div
        width: 800px
        min-height: 560px
        padding: 10px 0
        > div
            width: 680px
            padding: 18px 0
            table
                width: 640px
                font-size: 18px
            .r_player .name
                width: 114px
            .r_point .point
                font-size: 24px

#board .board .kaiju
    width: 800px
    height: 680px
    > div
        width: 580px
        margin: 120px auto auto
        border-radius: 6px
        .title
            margin: 40px 20px
            font-size: 32px
        .player
            position: relative
            font-size: 24px
            height: 136px
            margin: 1em 20px
            > div
                position: absolute
                width: 240px
                height: 38px
                padding: 0px 10px
                border-radius: 4px
                &.main
                    transform: translate(140px, 96px)
                &.xiajia
                    transform: translate(280px, 48px)
                &.duimian
                    transform: translate(140px, 0px)
                &.shangjia
                    transform: translate(0px, 48px)
