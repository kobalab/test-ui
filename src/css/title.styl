body.title
    color:      white
    background: black
    margin: 0
    #title
        display: block
    #navi
        width: 800px
        margin: 0 auto
    > .version
        display: none

#title
    display: none
    margin: 40px auto
    width: 640px
    padding: 4px
    border-radius: 5px
    background: white
    color:      black
    text-align: center
    font-family: text-font
    font-size: 16px
    h1
        margin: 0px
        height: 150px
        img
            width: 600px
    .version
        font-family: defen-font
        font-size: 24px
    .loading
        margin: 8px auto
        color: #666
        font-family: menu-font
        font-size: 16px
        animation: blink 2s infinite
    .start
        margin: 8px auto
        font-family: text-font
        width: 120px
        padding: 4px
        border-radius: 4px
        font-size: 16px
        color: white
        background: blue
        cursor: pointer
        &:hover
        &:focus
            background: #ccc
            outline: none

#title .login
    width: 80%
    margin: 0.5em auto
    input[type="submit"]
        cursor: pointer
    form.local
        margin: 0.5em
        input[name="name"]
            width: 8em
        input[type="submit"]
            border: none
            color: white
            background: blue
    form:not(.local)
        display: inline-block
        white-space: nowrap
        .logo
            display: inline-block
            width: 1.2em
            height: 1.2em
            vertical-align: text-bottom
            background-size: cover
        input[type=submit]
            width: 120px
            border: none
            background: none
            box-shadow: none
            font-weight: normal
            text-align: left
            padding: 0
        &.hatena .logo
            background-image: url(https://www.hatena.ne.jp/p/images/favicon.ico)
        &.google .logo
            background-image: url(https://www.google.com/favicon.ico)
