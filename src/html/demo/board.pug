- var width = 800
doctype html
html(lang="ja")
  head
    base(href="../dist/")
    include ../inc/meta
    title title
    include ../inc/style
    include ../inc/script
    script.
        const { show, hide, setSelector, clearSelector,
                scale } = Majiang.UI.Util;

        function start() {
            clearSelector('title');
            $('body').attr('class','board');
        };

        $(function(){
            
            $(window).on('resize', ()=>scale($('#board'), $('#space')));
            
            setSelector($('#title .start'), 'title');
            hide($('#title .loading'));
            $('#title .start').on('click', start)
            show($('#title .start'));
        });

  body.title
    include ../inc/navi
    include ../inc/title
    #space
    #board
      .board
      .controller
    .version ver. #{version}
