- var width = 800
doctype html
html(lang="ja")
  head
    base(href="../dist/")
    include ../inc/meta
    title title
    include ../inc/style
    include ../inc/script
    script.
        const { show, hide, setSelector, clearSelector } = Majiang.UI.Util;

        let loaded;
        
        function start() {
            clearSelector('title');
            $('audio').attr('controls', true);
            $('body').removeAttr('class');
        };

        $(function(){
            $(window).on('load', function(){
              setSelector($('#title .start'), 'title');
                hide($('#title .loading'));
                $('#title .start').on('click', start)
                show($('#title .start'));
            });
            if (loaded) $(window).trigger('load');
        });

        $(window).on('load', ()=> loaded = true);
  body.title
    #demo
      h1 title
      include ../inc/loaddata
      img(src="https://kobalab.net/majiang/img/game.png")
    include ../inc/title
