- var width = 800
doctype html
html(lang="ja")
  head
    base(href="../dist/")
    include ../inc/meta
    title layout
    include ../inc/style
    include ../inc/script
    style.
        #board .board {
            box-sizing: border-box;
            border: solid 5px #2a8;
        }
        #board .controller {
            box-sizing: border-box;
            border: solid 2px #0ff
        }
        #board .analyzer {
            background: rgba(0, 0, 0, 0.4);
            box-sizing: border-box;
            border: solid 1px white;
            border-radius: 4px;
        }
    script.
        const { show, hide, setSelector, clearSelector, scale } 
                                                    = Majiang.UI.Util;

        function start() {
            clearSelector('title');
            $('body').attr('class','board');
            scale($('#board'), $('#space'));
        };

        $(function(){

            $(window).on('resize', ()=>scale($('#board'), $('#space')));

            $('#board .board, #board .analyzer').on('click', ()=>{
                $('body').toggleClass('analyzer');
            });

            $('#board .navi [role="button"]').on('click', ()=>{
                $('#board .navi').toggleClass('active');
                return false;
            });

            setSelector($('#title .start'), 'title');
            hide($('#title .loading'));
            $('#title .start').on('click', start)
            show($('#title .start'));
        });

  body.title
    #navi
      include ../inc/navi
    include ../inc/title
    #space
    #board
      .board
      .analyzer
      .controller
      include ../inc/navi
    .version ver. #{version}
