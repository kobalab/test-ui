doctype html
html(lang="ja")
  head
    include ../inc/meta
    title test-ui
    include ../inc/version
    style.
      h1 {
        margin-bottom: 0;
      }
  body
    h1 test-ui
    .version ver. #{version}
    ul
      each page in ['font','form','blink','fadeIn','scale','selector','flipInput','live']
        li
          a(href=`${page}.html`)= page
      each page in ['pai','audio','preload','mianzi','shoupai','shan','he','board']
        li
          a(href=`${page}.html`)= page
    ul
      li
        a(href="../dist/index.html") V3
    a(href="https://github.com/kobalab/test-ui" target="_blank") GitHub
