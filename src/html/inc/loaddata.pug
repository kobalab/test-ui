#loaddata
  each s in ['m','p','s']
    each n in [1,2,3,4,5,6,7,8,9,0]
      img.pai(data-pai=s+n src=`img/${s}${n}.png` alt)
      |
      |
    br
    |
    |
  each n in [1,2,3,4,5,6,7]
    img.pai(data-pai=`z${n}` src=`img/z${n}.png` alt)
    |
    |
  img.pai(data-pai="_" src="img/pai.png" alt)
  |
  |
  br
  audio(data-name="dapai" src="audio/dahai11.wav" volume="0.2" preload)
  audio(data-name="chi"   src="audio/chi.wav"    volume="0.3" preload)
  audio(data-name="peng"  src="audio/peng.wav"     volume="0.3" preload)
  audio(data-name="gang"  src="audio/gang.wav"     volume="0.3" preload)
  audio(data-name="zimo"  src="audio/zimo.wav"   volume="0.3" preload)
  audio(data-name="rong"  src="audio/rong.wav"     volume="0.3" preload)
  audio(data-name="lizhi" src="audio/lizhi.wav"   volume="0.2" preload)
  audio(data-name="gong"  src="audio/nc43994.wav" volume="1.0" preload)
